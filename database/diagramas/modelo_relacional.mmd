    usuario |o--o{ historico_solicitacao : "alterado_por"
    solicitacao ||--o{ acompanhamento : "solicitacao_id"
    usuario |o--o{ acompanhamento : "registrado_por"
    usuario ||--o{ notificacao : "usuario_id"
    usuario ||--o{ analise_compatibilidade : "usuario_id"
    animal ||--o{ analise_compatibilidade : "animal_id"
    ong ||--o{ classificacao_imagem : "ong_id"
