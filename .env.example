# Copie este arquivo para ".env" e ajuste.

# false = chama a API real do back-end Python (padrão da versão 1.0.0)
# true  = modo demonstração: dados simulados no navegador, sem back-end
#         (só para desenvolver telas; NÃO use na apresentação)
VITE_USE_MOCK=false

# Endereço base da API. Com o proxy do vite.config.js, "/api" já aponta para http://localhost:8000
VITE_API_URL=/api
