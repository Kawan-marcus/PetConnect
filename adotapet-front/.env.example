# Copie este arquivo para ".env" e ajuste.

# true  = usa dados simulados no navegador (não precisa do backend rodando)
# false = chama a API real do backend Python
VITE_USE_MOCK=true

# Endereço base da API. Com o proxy do vite.config.js, "/api" já aponta para http://localhost:8000
VITE_API_URL=/api
