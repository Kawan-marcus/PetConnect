# Copie este arquivo para "backend/.env" e preencha com os dados do SEU MySQL.
# O arquivo .env NÃO vai para o GitHub (está no .gitignore).

DB_HOST=localhost
DB_PORT=3306
DB_USER=petconnect_app
DB_PASSWORD=troque_esta_senha
DB_NAME=petconnect

# Chave usada para assinar os tokens de login (JWT). Use um texto longo e aleatório.
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

# Módulo 3 (IA): onde calcular a compatibilidade em lote.
#   auto   = usa a GPU (OpenCL) se houver; senão NumPy na CPU
#   opencl = exige OpenCL     |   numpy = nunca usa OpenCL
IA_MOTOR=auto
